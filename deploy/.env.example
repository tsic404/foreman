# Local multica test stack credentials (compose `env_file`). Copy to .env and
# set real values; the backend's DATABASE_URL must embed the same
# POSTGRES_PASSWORD (compose interpolates it, so it cannot drift).
POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
MULTICA_DEV_VERIFICATION_CODE=888888
